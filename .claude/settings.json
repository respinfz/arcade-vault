{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/format-and-lint.mjs\"",
            "timeout": 60,
            "statusMessage": "Formateando con Prettier + ESLint..."
          }
        ]
      }
    ]
  }
}
